# ─── Backend ────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL (Neon.tech or any Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/lab1708?sslmode=require"

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Gmail App Password recommended)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Lab 1708 <your_email@gmail.com>"

# Client URL (for CORS and email links)
CLIENT_URL=http://localhost:5173

# ─── Frontend ───────────────────────────────────────────────────────────────

# Vite environment variables (must be prefixed with VITE_)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# ─── Docker Hub (CI/CD secrets — set in GitHub repository settings) ─────────
# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_access_token

# ─── Render Deploy Hooks (CI/CD secrets) ────────────────────────────────────
# RENDER_DEPLOY_HOOK_BACKEND=https://api.render.com/deploy/srv-xxx?key=yyy
# RENDER_DEPLOY_HOOK_FRONTEND=https://api.render.com/deploy/srv-xxx?key=yyy
